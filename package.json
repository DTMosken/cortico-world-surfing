{
  "name": "cortico-world-surfing",
  "version": "0.1.0",
  "type": "module",
  "description": "读取公开网页正文和 B站字幕，支持视频搜索、分段续读和可调返回量。",
  "author": "DTMosken",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/definition.ts",
  "cortico": {
    "kind": "world",
    "api": 5,
    "displayName": "网上冲浪",
    "consoleClient": "dist/console.js"
  },
  "files": [
    "src",
    "dist",
    "scripts/install-browser.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node scripts/build-engine.mjs && vitest run",
    "build:engine": "node scripts/build-engine.mjs",
    "build:console": "node scripts/build-engine.mjs",
    "typecheck": "tsc --noEmit",
    "install:browser": "node scripts/install-browser.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.5.0",
    "jsdom": "27.4.0",
    "playwright": "1.63.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.10.0",
    "cortico": "^0.1.5",
    "esbuild": "0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
