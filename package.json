{
  "name": "cortico-world-surfing",
  "version": "0.3.1",
  "type": "module",
  "description": "读取公开网页正文和 B站视频简介、字幕、评论，支持视频搜索、分段续读和可调返回量。",
  "author": "DTMosken",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "bilibili",
    "web-reader",
    "subtitles",
    "playwright"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/definition.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "网上冲浪",
    "tags": [
      "internet",
      "browser",
      "video"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "scripts/install-browser.mjs",
    "README.md",
    "LICENSE",
    "describe.json",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "test": "node scripts/build-engine.mjs && vitest run",
    "build:engine": "node scripts/build-engine.mjs",
    "typecheck": "tsc --noEmit",
    "install:browser": "node scripts/install-browser.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.5.0",
    "jsdom": "27.4.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.10.0",
    "cortico": "0.2.10",
    "esbuild": "0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTMosken/cortico-world-surfing.git"
  },
  "homepage": "https://github.com/DTMosken/cortico-world-surfing#readme",
  "bugs": {
    "url": "https://github.com/DTMosken/cortico-world-surfing/issues"
  }
}
